{
  "name": "interactive-mcp-desktop",
  "version": "1.0.0",
  "description": "Desktop app for Interactive MCP Server — SSE transport for Android Studio and other HTTP-based MCP clients",
  "repository": {
    "type": "git",
    "url": "https://github.com/josippapez/interactive-mcp-server.git",
    "directory": "desktop"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run rebuild:electron && electron-vite dev",
    "build": "npm run rebuild:electron && electron-vite build",
    "preview": "electron-vite preview",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "rm -rf node_modules/better-sqlite3/build && electron-rebuild -f -w better-sqlite3 --build-from-source",
    "copy:opencode": "node scripts/copy-opencode.js",
    "copy:opencode:mac": "node scripts/copy-opencode.js --platform darwin",
    "copy:opencode:mac-arm64": "node scripts/copy-opencode.js --platform darwin --arch arm64",
    "copy:opencode:mac-x64": "node scripts/copy-opencode.js --platform darwin --arch x64",
    "copy:opencode:win": "node scripts/copy-opencode.js --platform windows --arch x64",
    "copy:opencode:linux": "node scripts/copy-opencode.js --platform linux --arch x64",
    "package": "npm run rebuild:electron && npm run copy:opencode && electron-vite build && electron-builder --config",
    "package:mac": "npm run rebuild:electron && npm run copy:opencode:mac && electron-vite build && electron-builder --mac --config",
    "package:mac-arm64": "npm run rebuild:electron && npm run copy:opencode:mac-arm64 && ENABLE_BYTECODE=1 electron-vite build && electron-builder --mac --arm64 --config",
    "package:mac-x64": "npm run rebuild:electron && npm run copy:opencode:mac-x64 && electron-vite build && electron-builder --mac --x64 --config",
    "package:win": "npm run rebuild:electron && npm run copy:opencode:win && electron-vite build && electron-builder --win --config",
    "package:linux": "npm run rebuild:electron && npm run copy:opencode:linux && electron-vite build && electron-builder --linux --config",
    "package:all": "echo 'Use platform-specific package commands for bundled OpenCode'",
    "package:dir": "npm run rebuild:electron && npm run copy:opencode && electron-vite build && electron-builder --dir --config",
    "test": "npm run rebuild:node && vitest run",
    "test:watch": "npm run rebuild:node && vitest"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.96",
    "@gsap/react": "^2.1.2",
    "@huggingface/transformers": "^4.0.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@opencode-ai/sdk": "^1.14.18",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/pacer": "^0.17.0",
    "@tanstack/react-virtual": "^3.13.23",
    "@tanstack/store": "^0.7.0",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "express": "^5.2.1",
    "gsap": "^3.15.0",
    "jotai": "^2.19.1",
    "jszip": "^3.10.1",
    "morphdom": "^2.7.8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "use-stick-to-bottom": "^1.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^28.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.6.1",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  },
  "build": {
    "appId": "com.interactive-mcp.desktop",
    "productName": "Interactive MCP",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      "resources/**"
    ]
  }
}
